[Unit]
Description=Apah Sovereign AI Engine & Dashboard User Service
Documentation=https://github.com/p19racha/Apah
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/apah --no-browser
Restart=on-failure
RestartSec=5s
Environment="APAH_AIRGAP_MODE=1"

[Install]
WantedBy=default.target
